{
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
        "**/dist": true,
        "**/node_modules": true,
        "**/.yarn": true,
        "**/*.tsbuildinfo": true,
        "**/vitest.config.js": true,
        "**/vitest.config.d.ts": true,
        "**/vitest.config.d.ts.map": true,
        "**/*.js.map": true,
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/dist": true,
    },
    // TypeScript: use the workspace version and watch via project references.
    "typescript.tsdk": "node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": false,
    // Run tsc --build on save via the default build task (tasks.json).
    "editor.formatOnSave": true,
    "typescript.tsc.autoDetect": "off"
}