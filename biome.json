{
    "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": false,
        "includes": [
            "**",
            "!**/dist",
            "!**/node_modules",
            "!**/.yarn",
            "!**/.claude",
            "!**/*.tsbuildinfo"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": {
                    "level": "on"
                }
            }
        }
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noNonNullAssertion": "warn",
                "useBlockStatements": "error"
            },
            "suspicious": {
                "noAssignInExpressions": "warn",
                "noExplicitAny": "warn",
                "noConsole": "error"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "**/packages/gen/**",
                "**/packages/sandbox-cli/**",
                "**/packages/sandbox-server/src/examples/**",
                "**/scripts/**"
            ],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noConsole": "off"
                    }
                }
            }
        }
    ],
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "trailingCommas": "all",
            "semicolons": "always",
            "bracketSpacing": true
        }
    }
}
