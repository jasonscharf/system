{
  "name": "@system/api",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn compile",
    "compile": "tsc -b",
    "clean": "rm -rf dist && rm tsconfig.tsbuildinfo",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -b -w"
  },
  "dependencies": {
    "@system/core": "workspace:^",
    "koa": "^3.1.1",
    "koa-bodyparser": "^4.4.1",
    "koa-router": "^14.0.0"
  },
  "devDependencies": {
    "@types/koa": "^3",
    "@types/koa-bodyparser": "^4"
  }
}
