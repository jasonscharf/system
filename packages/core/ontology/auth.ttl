# Tern Auth Ontology — Turtle format
# Namespace: urn:sys:core:auth:

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix auth: <urn:sys:core:auth:> .

# ── Classes ───────────────────────────────────────────────────────────────────

auth:User         a owl:Class ; rdfs:comment "A Tern platform user." .
auth:UserIdentity a owl:Class ; rdfs:comment "An OAuth identity linked to a user." .
auth:UserSession  a owl:Class ; rdfs:comment "An active session for a user on a device." .
auth:UserDevice   a owl:Class ; rdfs:comment "A device from which a user authenticates." .
auth:LoginAttempt a owl:Class ; rdfs:comment "An in-flight or completed OAuth login attempt." .

# ── User properties ───────────────────────────────────────────────────────────

auth:email a owl:DatatypeProperty ;
    rdfs:domain auth:User ;
    rdfs:range  xsd:string ;
    rdfs:comment "Primary email address." .

auth:displayName a owl:DatatypeProperty ;
    rdfs:domain auth:User ;
    rdfs:range  xsd:string ;
    rdfs:comment "Human-readable display name." .

auth:avatarUrl a owl:DatatypeProperty ;
    rdfs:domain auth:User ;
    rdfs:range  xsd:anyURI ;
    rdfs:comment "URL of the user's avatar image." .

# ── UserIdentity properties ───────────────────────────────────────────────────

auth:provider a owl:DatatypeProperty ;
    rdfs:domain auth:UserIdentity, auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "OAuth provider identifier (e.g. 'google', 'github')." .

auth:providerUserId a owl:DatatypeProperty ;
    rdfs:domain auth:UserIdentity ;
    rdfs:range  xsd:string ;
    rdfs:comment "The user's ID as issued by the OAuth provider." .

auth:providerEmail a owl:DatatypeProperty ;
    rdfs:domain auth:UserIdentity ;
    rdfs:range  xsd:string ;
    rdfs:comment "Email returned by the OAuth provider." .

auth:accessToken a owl:DatatypeProperty ;
    rdfs:domain auth:UserIdentity ;
    rdfs:range  xsd:string ;
    rdfs:comment "Current OAuth access token." .

auth:refreshToken a owl:DatatypeProperty ;
    rdfs:domain auth:UserIdentity ;
    rdfs:range  xsd:string ;
    rdfs:comment "OAuth refresh token (may be absent for some providers)." .

auth:tokenExpiresAt a owl:DatatypeProperty ;
    rdfs:domain auth:UserIdentity ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "Expiry time of the current access token." .

# ── UserDevice properties ─────────────────────────────────────────────────────

auth:deviceName a owl:DatatypeProperty ;
    rdfs:domain auth:UserDevice ;
    rdfs:range  xsd:string ;
    rdfs:comment "Human-readable device name (e.g. 'Chrome on macOS')." .

auth:devicePlatform a owl:DatatypeProperty ;
    rdfs:domain auth:UserDevice ;
    rdfs:range  xsd:string ;
    rdfs:comment "Device platform: 'web', 'ios', 'android', or 'desktop'." .

auth:deviceUserAgent a owl:DatatypeProperty ;
    rdfs:domain auth:UserDevice ;
    rdfs:range  xsd:string ;
    rdfs:comment "Raw HTTP User-Agent string." .

# ── UserSession properties ────────────────────────────────────────────────────

auth:sessionToken a owl:DatatypeProperty ;
    rdfs:domain auth:UserSession ;
    rdfs:range  xsd:string ;
    rdfs:comment "Opaque session token stored in a cookie." .

auth:expiresAt a owl:DatatypeProperty ;
    rdfs:domain auth:UserSession ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "Session expiry timestamp." .

auth:isActive a owl:DatatypeProperty ;
    rdfs:domain auth:UserSession ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "Whether the session is currently valid." .

auth:ipAddress a owl:DatatypeProperty ;
    rdfs:domain auth:UserSession, auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "Client IP address at time of login." .

# ── LoginAttempt properties ───────────────────────────────────────────────────

auth:status a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "Lifecycle status of the login attempt (e.g. 'pending', 'success', 'error')." .

auth:nonce a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "Opaque single-use nonce correlating the OAuth redirect round-trip." .

auth:claim a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional claim/invite token presented at the start of the attempt." .

auth:userAgent a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "Raw HTTP User-Agent string captured at attempt time." .

auth:errorCode a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "Error code recorded when the attempt fails." .

auth:utmSource a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "UTM source attribution captured at attempt time." .

auth:utmMedium a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "UTM medium attribution captured at attempt time." .

auth:utmCampaign a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:string ;
    rdfs:comment "UTM campaign attribution captured at attempt time." .

auth:authRedirectUrl a owl:DatatypeProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  xsd:anyURI ;
    rdfs:comment "Post-login redirect URL requested at attempt time." .

# ── Shared properties (multiple domains) ─────────────────────────────────────

auth:createdAt a owl:DatatypeProperty ;
    rdfs:domain auth:User, auth:UserIdentity, auth:UserSession, auth:UserDevice, auth:LoginAttempt ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "Creation timestamp." .

auth:updatedAt a owl:DatatypeProperty ;
    rdfs:domain auth:User, auth:UserIdentity, auth:LoginAttempt ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "Last-updated timestamp." .

# ── Object properties ─────────────────────────────────────────────────────────

auth:identityOf a owl:ObjectProperty ;
    rdfs:domain auth:UserIdentity ;
    rdfs:range  auth:User ;
    rdfs:comment "Links an identity to its owning user." .

auth:sessionUser a owl:ObjectProperty ;
    rdfs:domain auth:UserSession ;
    rdfs:range  auth:User ;
    rdfs:comment "The user this session belongs to." .

auth:sessionDevice a owl:ObjectProperty ;
    rdfs:domain auth:UserSession ;
    rdfs:range  auth:UserDevice ;
    rdfs:comment "The device this session was created on." .

auth:deviceUser a owl:ObjectProperty ;
    rdfs:domain auth:UserDevice ;
    rdfs:range  auth:User ;
    rdfs:comment "The user who owns this device record." .

auth:attemptUser a owl:ObjectProperty ;
    rdfs:domain auth:LoginAttempt ;
    rdfs:range  auth:User ;
    rdfs:comment "The user resolved by a successful login attempt." .
