# Tern Core Platform Ontology — Turtle format
# Namespace: urn:sys:core:core:
#
# Defines the fundamental graph constructs used by @system/entities:
#   PropGroup / Handle — property grouping for extension model
#   CollectionView     — ordered, filterable views over collection properties
#   CollectionViewItem — individual member of a CollectionView

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sys: <urn:sys:core:core:> .

# ── PropGroup infrastructure ──────────────────────────────────────────────────

sys:propGroup a owl:ObjectProperty ;
    rdfs:comment "Links an entity node to one of its PropGroup nodes." .

sys:handle a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:comment "The handle string ('id@version') identifying a PropGroup." .

# ── CollectionView ────────────────────────────────────────────────────────────
#
# A CollectionView is a graph-native view over a collection property on a
# PropGroup node.  It stores sorting parameters and maintains an ordered list
# of CollectionViewItem nodes — one per item currently in the source collection.
#
# When items are added to the source collection via EntityStore.collectionPush,
# the corresponding CollectionViewItem nodes are created automatically.
# Removal via collectionRemove likewise removes the corresponding item.
#
# Example (Group has members; User holds a view over those members):
#
#   group:abc/pg/tern_core_v1  ← PropGroup that owns the members collection
#   view:xyz  sys:cvSource  "group:abc/pg/tern_core_v1"
#   view:xyz  sys:cvProp    "http://test.dev/group/member"
#   view:xyz  sys:cvSortProp "urn:sys:core:auth:displayName"
#   view:xyz  sys:cvSortDir  "asc"
#   view:xyz  sys:cvItem    view-item:1
#   view-item:1  sys:cviView  view:xyz
#   view-item:1  sys:cviRef   "urn:sys:core:auth:user:alice_id"
#   view-item:1  sys:cviPos   0

sys:CollectionView a owl:Class ;
    rdfs:comment "A view over a collection property.  Stores sort/filter config and owns CollectionViewItems." .

sys:CollectionViewItem a owl:Class ;
    rdfs:comment "One entry in a CollectionView.  Points back to its parent view and to the actual item." .

# ── CollectionView data properties ───────────────────────────────────────────

sys:cvSource a owl:DatatypeProperty ;
    rdfs:domain sys:CollectionView ;
    rdfs:range  xsd:string ;
    rdfs:comment "IRI string of the PropGroup node that owns the source collection." .

sys:cvProp a owl:DatatypeProperty ;
    rdfs:domain sys:CollectionView ;
    rdfs:range  xsd:string ;
    rdfs:comment "IRI string of the property on the source PropGroup this view is over." .

sys:cvSortProp a owl:DatatypeProperty ;
    rdfs:domain sys:CollectionView ;
    rdfs:range  xsd:string ;
    rdfs:comment "Optional IRI string of the property to sort by on each referenced entity." .

sys:cvSortDir a owl:DatatypeProperty ;
    rdfs:domain sys:CollectionView ;
    rdfs:range  xsd:string ;
    rdfs:comment "Sort direction: 'asc' or 'desc' (default 'asc')." .

# ── CollectionView object properties ─────────────────────────────────────────

sys:cvItem a owl:ObjectProperty ;
    rdfs:domain sys:CollectionView ;
    rdfs:range  sys:CollectionViewItem ;
    rdfs:comment "Links a CollectionView to one of its CollectionViewItems." .

# ── CollectionViewItem data properties ───────────────────────────────────────

sys:cviRef a owl:DatatypeProperty ;
    rdfs:domain sys:CollectionViewItem ;
    rdfs:range  xsd:string ;
    rdfs:comment "String representation of the referenced collection item (IRI or plain value)." .

sys:cviPos a owl:DatatypeProperty ;
    rdfs:domain sys:CollectionViewItem ;
    rdfs:range  xsd:integer ;
    rdfs:comment "Zero-based position of this item within the CollectionView." .

# ── CollectionViewItem object properties ─────────────────────────────────────

sys:cviView a owl:ObjectProperty ;
    rdfs:domain sys:CollectionViewItem ;
    rdfs:range  sys:CollectionView ;
    rdfs:comment "Back-link from a CollectionViewItem to its parent CollectionView." .
