# Tern RBAC Ontology — Turtle format
# Namespace: urn:sys:core:rbac:

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix rbac: <urn:sys:core:rbac:> .

# ── Classes ───────────────────────────────────────────────────────────────────

rbac:Install        a owl:Class ;
    rdfs:comment "A deployment of the platform (cloud-native, hybrid, or on-premise). Contains one or more Tenants." .

rbac:Tenant         a owl:Class ;
    rdfs:comment "An isolation boundary scoped to a single Install. All groups, roles, and resources belong to a tenant." .

rbac:UserGroup       a owl:Class ;
    rdfs:comment "A named collection of principals (users, service accounts, or nested groups)." .

rbac:ServiceAccount a owl:Class ;
    rdfs:comment "A non-human principal for automated or service-to-service access." .

rbac:Role           a owl:Class ;
    rdfs:comment "A named set of permissions, assignable to groups or principals via a PolicyGrant." .

rbac:Permission     a owl:Class ;
    rdfs:comment "An atomic capability, identified by a dot-separated key such as 'invoice.read'. '*' is the wildcard." .

rbac:PolicyGrant    a owl:Class ;
    rdfs:comment "An explicit binding of a principal (or group) to a role or permission within a scope." .

rbac:ResourceNode   a owl:Class ;
    rdfs:comment "A resource that can serve as the scope for a policy grant and participate in the resource hierarchy." .

# ── Install properties ───────────────────────────────────────────────────────

rbac:installName    a owl:DatatypeProperty ;
    rdfs:domain rbac:Install ;
    rdfs:range  xsd:string ;
    rdfs:comment "Human-readable install name." .

rbac:isSystemInstall a owl:DatatypeProperty ;
    rdfs:domain rbac:Install ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "True for the single system-level Install; protects it from deletion." .

rbac:installKind    a owl:DatatypeProperty ;
    rdfs:domain rbac:Install ;
    rdfs:range  xsd:string ;
    rdfs:comment "Deployment kind: cloud, hybrid, or on-premise." .

# ── Tenant properties ─────────────────────────────────────────────────────────

rbac:tenantName     a owl:DatatypeProperty ;
    rdfs:domain rbac:Tenant ;
    rdfs:range  xsd:string ;
    rdfs:comment "Human-readable tenant name." .

rbac:isSystemTenant a owl:DatatypeProperty ;
    rdfs:domain rbac:Tenant ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "True for the system-level root tenant; protects it from deletion." .

# ── UserGroup properties ──────────────────────────────────────────────────────

rbac:groupName      a owl:DatatypeProperty ;
    rdfs:domain rbac:UserGroup ;
    rdfs:range  xsd:string ;
    rdfs:comment "Human-readable user group name." .

rbac:isSystemGroup  a owl:DatatypeProperty ;
    rdfs:domain rbac:UserGroup ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "True for system-managed groups (e.g. superusers); protects them from deletion." .

# ── ServiceAccount properties ─────────────────────────────────────────────────

rbac:serviceAccountName a owl:DatatypeProperty ;
    rdfs:domain rbac:ServiceAccount ;
    rdfs:range  xsd:string ;
    rdfs:comment "Human-readable service account name." .

rbac:serviceAccountToken a owl:DatatypeProperty ;
    rdfs:domain rbac:ServiceAccount ;
    rdfs:range  xsd:string ;
    rdfs:comment "Opaque credential token; callers should store the hash, not the plaintext." .

rbac:serviceAccountIsActive a owl:DatatypeProperty ;
    rdfs:domain rbac:ServiceAccount ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "Whether the service account is currently enabled." .

# ── Role properties ───────────────────────────────────────────────────────────

rbac:roleName       a owl:DatatypeProperty ;
    rdfs:domain rbac:Role ;
    rdfs:range  xsd:string ;
    rdfs:comment "Human-readable role name." .

rbac:isSystemRole   a owl:DatatypeProperty ;
    rdfs:domain rbac:Role ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "True for built-in system roles; protects them from deletion." .

# ── Permission properties ─────────────────────────────────────────────────────

rbac:permissionKey  a owl:DatatypeProperty ;
    rdfs:domain rbac:Permission ;
    rdfs:range  xsd:string ;
    rdfs:comment "Dot-separated action key, e.g. 'invoice.read'. '*' is the system wildcard." .

# ── PolicyGrant properties ────────────────────────────────────────────────────

rbac:isDenial       a owl:DatatypeProperty ;
    rdfs:domain rbac:PolicyGrant ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "When true this grant explicitly denies rather than allows. Denial at a tighter scope wins over an allow at a broader scope." .

rbac:grantExpiresAt a owl:DatatypeProperty ;
    rdfs:domain rbac:PolicyGrant ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "When the grant expires. Absent means the grant is permanent." .

# ── ResourceNode properties ───────────────────────────────────────────────────

rbac:resourceType   a owl:DatatypeProperty ;
    rdfs:domain rbac:ResourceNode ;
    rdfs:range  xsd:string ;
    rdfs:comment "Application-defined resource type key, e.g. 'org', 'project', 'dataset'." .

# ── Shared timestamps ─────────────────────────────────────────────────────────

# ── Object properties ─────────────────────────────────────────────────────────

rbac:hasTenant      a owl:ObjectProperty ;
    rdfs:domain rbac:Install ;
    rdfs:range  rbac:Tenant ;
    rdfs:comment "Outward edge: an Install contains a Tenant (root→down)." .

rbac:isMemberOf       a owl:ObjectProperty ;
    rdfs:comment "A principal or group is a direct member of a group. Transitive membership is resolved at query time." .

rbac:isInTenant       a owl:ObjectProperty ;
    rdfs:domain rbac:UserGroup, rbac:Role, rbac:ServiceAccount, rbac:ResourceNode ;
    rdfs:range  rbac:Tenant ;
    rdfs:comment "Scopes a group, role, service account, or resource to a tenant." .

rbac:inheritsFrom   a owl:ObjectProperty ;
    rdfs:domain rbac:Role ;
    rdfs:range  rbac:Role ;
    rdfs:comment "This role inherits all permissions from the target role. Forms a DAG — cycles are prohibited." .

rbac:grants         a owl:ObjectProperty ;
    rdfs:domain rbac:Role ;
    rdfs:range  rbac:Permission ;
    rdfs:comment "A role directly grants a permission." .

rbac:hasParent a owl:ObjectProperty ;
    rdfs:domain rbac:ResourceNode ;
    rdfs:range  rbac:ResourceNode ;
    rdfs:comment "Parent resource in the hierarchy. Grants made on a parent propagate to all descendants." .

rbac:hasPrincipal a owl:ObjectProperty ;
    rdfs:domain rbac:PolicyGrant ;
    rdfs:comment "The principal (User, UserGroup, or ServiceAccount) receiving the grant." .

rbac:hasRole      a owl:ObjectProperty ;
    rdfs:domain rbac:PolicyGrant ;
    rdfs:range  rbac:Role ;
    rdfs:comment "The role being granted. Mutually exclusive with grantPermission." .

rbac:hasPermission a owl:ObjectProperty ;
    rdfs:domain rbac:PolicyGrant ;
    rdfs:range  rbac:Permission ;
    rdfs:comment "A direct permission grant. Mutually exclusive with grantRole." .

rbac:hasScope     a owl:ObjectProperty ;
    rdfs:domain rbac:PolicyGrant ;
    rdfs:comment "The resource or tenant the grant is scoped to. Absent means the grant is system-wide." .

rbac:grantedBy      a owl:ObjectProperty ;
    rdfs:domain rbac:PolicyGrant ;
    rdfs:comment "The principal who created this grant (immutable audit trail)." .

rbac:delegatedFrom  a owl:ObjectProperty ;
    rdfs:domain rbac:PolicyGrant ;
    rdfs:range  rbac:PolicyGrant ;
    rdfs:comment "The originating PolicyGrant that authorized this delegated grant." .

rbac:actsFor        a owl:ObjectProperty ;
    rdfs:comment "Grants principal A the ability to act as principal B. Used for impersonation and delegation." .
