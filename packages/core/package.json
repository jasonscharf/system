{
    "name": "@jasonscharf/core",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "browser": "./dist/browser.js",
            "source": "./src/index.ts",
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./tenancy": {
            "source": "./src/tenancy/index.ts",
            "default": "./dist/tenancy/index.js",
            "types": "./dist/tenancy/index.d.ts",
            "import": "./dist/tenancy/index.js"
        },
        "./licensing": {
            "source": "./src/licensing/index.ts",
            "default": "./dist/licensing/index.js",
            "types": "./dist/licensing/index.d.ts",
            "import": "./dist/licensing/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "ontology"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jasonlscharf/system.git",
        "directory": "packages/core"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "scripts": {
        "build": "yarn compile",
        "gen": "tern-codegen --config tern-gen.json && tern-codegen --config tern-gen-rbac.json && tern-codegen --config tern-gen-tenancy.json && tern-codegen --config tern-gen-licensing.json",
        "gen:watch": "tern-codegen --watch",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm tsconfig.tsbuildinfo",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "watch": "tsc -b -w"
    }
}
