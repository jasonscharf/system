{
    "name": "@jasonscharf/dashboards",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./react": {
            "source": "./src/react/index.ts",
            "types": "./dist/react/index.d.ts",
            "import": "./dist/react/index.js"
        },
        "./dashboards.css": "./src/dashboards.css"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "src/dashboards.css"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jasonlscharf/system.git",
        "directory": "packages/dashboards"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "vitest run --config vitest.config.ts",
        "test:watch": "vitest watch --config vitest.config.ts",
        "lint": "biome check src vitest.config.ts"
    },
    "dependencies": {
        "@jasonscharf/core": "workspace:^",
        "@jasonscharf/core-ui": "workspace:^"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.1",
        "@testing-library/react": "^16.3.1",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^4.0.0",
        "jsdom": "^27.4.0",
        "react": "^19.2.3",
        "react-dom": "^19.2.3",
        "vitest": "^4.0.16"
    }
}
