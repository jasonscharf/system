{
  "name": "@jasonscharf/entities",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jasonlscharf/system.git",
    "directory": "packages/entities"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "scripts": {
    "build": "yarn compile",
    "compile": "tsc -b",
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -b -w"
  },
  "dependencies": {
    "@jasonscharf/core": "workspace:^",
    "@jasonscharf/data": "workspace:^",
    "@jasonscharf/gen": "workspace:^",
    "@jasonscharf/server": "workspace:^"
  }
}
