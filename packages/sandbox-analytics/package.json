{
  "name": "@system/sandbox-analytics",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": [
    "dist",
    "ontology"
  ],
  "scripts": {
    "build": "yarn compile",
    "compile": "tsc -b",
    "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
    "codegen": "node ../gen/dist/bin.js --config tern-gen.json",
    "codegen:watch": "node ../gen/dist/bin.js --watch ./ontology/*.ttl",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@system/core": "workspace:^",
    "@system/gen": "workspace:^"
  }
}
