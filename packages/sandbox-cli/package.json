{
  "name": "@system/sandbox-cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "sandbox": "./dist/bin.js"
  },
  "scripts": {
    "build": "yarn compile",
    "compile": "tsc -b",
