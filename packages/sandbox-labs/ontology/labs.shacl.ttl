# Analytics SHACL Shapes — Turtle format
# Namespace: urn:sys:ext:labs:shapes:
#
# UserAnalyticsShape  — targets auth:User
#   Constrains only the fields that are meaningful in the analytics context;
#   core User properties remain under core's authority.
#
# ProjectShape — targets labs:Project, sh:closed true
#   All Project properties are formally constrained here.
#   sh:closed means extra properties not listed are violations.

@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:        <http://www.w3.org/ns/shacl#> .
@prefix auth:      <urn:sys:core:auth:> .
@prefix labs:      <urn:sys:ext:labs:> .
@prefix shapes:    <urn:sys:ext:labs:shapes:> .

# ── UserAnalyticsShape ────────────────────────────────────────────────────────

shapes:UserAnalyticsShape a sh:NodeShape ;
    sh:targetClass auth:User ;

    sh:property [
        sh:path     auth:email ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "A valid email address is required."
    ] ;

    sh:property [
        sh:path     labs:analyticsRole ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern  "^(owner|member|viewer)$" ;
        sh:message  "analyticsRole must be 'owner', 'member', or 'viewer'."
    ] ;

    sh:property [
        sh:path     labs:consentedToTracking ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path     labs:lastActiveAt ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime
    ] .

# ── ProjectShape ──────────────────────────────────────────────────────────────

shapes:ProjectShape a sh:NodeShape ;
    sh:targetClass labs:Project ;
    sh:closed      true ;

    sh:property [
        sh:path     labs:projectName ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:message  "projectName is required."
    ] ;

    sh:property [
        sh:path     labs:projectSlug ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern  "^[a-z0-9][a-z0-9-]+[a-z0-9]$" ;
        sh:message  "projectSlug must be lowercase-kebab-case (e.g. 'my-project')."
    ] ;

    sh:property [
        sh:path     labs:projectOwner ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class    auth:User ;
        sh:message  "Every project must have exactly one owner."
    ] ;

    sh:property [
        sh:path  labs:projectMember ;
        sh:class auth:User
    ] ;

    sh:property [
        sh:path     labs:isActive ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean
    ] ;

    sh:property [
        sh:path     labs:projectCreatedAt ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime
    ] .
