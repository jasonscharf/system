# Labs Extension Ontology — Turtle format
# Namespace:  http://tern.dev/ns/labs/
# Extends:    http://tern.dev/ns/auth/ (User)
#
# Strategy: add new OWL properties whose rdfs:domain points at an existing
# class (auth:User).  RDF's Open World Assumption makes this valid without
# modifying the base package.  When the codegen merges all triples, cross-
# namespace domain links resolve, and it emits a TypeScript module augmentation
# for the extended class plus a normal interface for locally-defined classes.

@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix auth:      <http://tern.dev/ns/auth/> .
@prefix labs:      <http://tern.dev/ns/labs/> .

# ── New class ─────────────────────────────────────────────────────────────────

labs:Project a owl:Class ;
    rdfs:comment "An analytics workspace scoped to a team or product." .

# ── Property group: User extensions ──────────────────────────────────────────
# rdfs:domain auth:User — codegen emits these into a declare module augmentation.

labs:analyticsRole a owl:DatatypeProperty ;
    rdfs:domain auth:User ;
    rdfs:range  xsd:string ;
    rdfs:comment "Platform role: 'owner', 'member', or 'viewer'." .

labs:lastActiveAt a owl:DatatypeProperty ;
    rdfs:domain auth:User ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "Timestamp of the user's most recent analytics activity." .

labs:consentedToTracking a owl:DatatypeProperty ;
    rdfs:domain auth:User ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "GDPR tracking consent flag." .

# ── Property group: Project data ──────────────────────────────────────────────

labs:projectName a owl:DatatypeProperty ;
    rdfs:domain labs:Project ;
    rdfs:range  xsd:string ;
    rdfs:comment "Human-readable project name." .

labs:projectSlug a owl:DatatypeProperty ;
    rdfs:domain labs:Project ;
    rdfs:range  xsd:string ;
    rdfs:comment "URL-safe identifier.  SHACL pattern: ^[a-z0-9][a-z0-9-]+[a-z0-9]$" .

labs:isActive a owl:DatatypeProperty ;
    rdfs:domain labs:Project ;
    rdfs:range  xsd:boolean ;
    rdfs:comment "Whether this project is currently active." .

labs:projectCreatedAt a owl:DatatypeProperty ;
    rdfs:domain labs:Project ;
    rdfs:range  xsd:dateTime ;
    rdfs:comment "Project creation timestamp." .

# ── Property group: Project relationships ─────────────────────────────────────
# Object properties cross namespace boundaries — range is auth:User.
# The codegen resolves auth:User → TypeScript type 'User' and imports it from
# '@system/core' automatically.

labs:projectOwner a owl:ObjectProperty ;
    rdfs:domain labs:Project ;
    rdfs:range  auth:User ;
    rdfs:comment "The user who created and owns this project." .

labs:projectMember a owl:ObjectProperty ;
    rdfs:domain labs:Project ;
    rdfs:range  auth:User ;
    rdfs:comment "A collaborator with access to this project (0 or more)." .
