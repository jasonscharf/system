{
    "name": "@jasonscharf/sandbox-labs",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "ontology"
    ],
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
        "gen": "tern-codegen",
        "gen:watch": "tern-codegen --watch",
        "start": "node dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@jasonscharf/auth": "workspace:^",
        "@jasonscharf/core": "workspace:^",
        "@jasonscharf/entities": "workspace:^",
        "@jasonscharf/gen": "workspace:^"
    },
    "tern": {
        "extension": "urn:sys:ext:labs",
        "requires": [
            "urn:sys:core"
        ],
        "bases": [
            {
                "ontology": "../core/ontology/auth.ttl",
                "package": "@jasonscharf/core",
                "importPath": "@jasonscharf/core"
            }
        ],
        "extensions": [
            "./ontology/labs.ttl"
        ],
        "shapes": [
            "./ontology/labs.shacl.ttl"
        ],
        "localNamespace": "urn:sys:ext:labs:",
        "out": "./src/labs/types.generated.ts",
        "shapesOut": "./src/labs/shapes.generated.ts",
        "schemasOut": "./src/labs/schemas.generated.ts",
        "extensionOut": "./src/labs/extension.generated.ts"
    }
}
