{
    "name": "@terncosoftware/sandbox-server",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
        "start": "node dist/index.js",
        "start:debug": "node --inspect=0.0.0.0:9229 dist/index.js",
        "start:rbac": "node --experimental-vm-modules dist/examples/rbac.js",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@terncosoftware/app": "workspace:^",
        "@terncosoftware/auth": "workspace:^",
        "@terncosoftware/convos": "workspace:^",
        "@terncosoftware/core": "workspace:^",
        "@terncosoftware/data": "workspace:^",
        "@terncosoftware/flow": "workspace:^",
        "@terncosoftware/server": "workspace:^",
        "@terncosoftware/vaults": "workspace:^",
        "better-sqlite3": "^11.10.0",
        "ioredis": "^5.6.1",
        "pg": "^8.16.0"
    }
}
