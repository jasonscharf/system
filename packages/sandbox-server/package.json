{
    "name": "@jasonscharf/sandbox-server",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
        "start": "node dist/index.js",
        "start:debug": "node --inspect=0.0.0.0:9229 dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@jasonscharf/app": "workspace:^",
        "@jasonscharf/auth": "workspace:^",
        "@jasonscharf/convos": "workspace:^",
        "@jasonscharf/core": "workspace:^",
        "@jasonscharf/data": "workspace:^",
        "@jasonscharf/flow": "workspace:^",
        "@jasonscharf/server": "workspace:^",
        "@jasonscharf/vaults": "workspace:^",
        "better-sqlite3": "^11.10.0",
        "ioredis": "^5.6.1",
        "pg": "^8.16.0"
    }
}
