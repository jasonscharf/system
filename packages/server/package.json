{
    "name": "@jasonscharf/server",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jasonlscharf/system.git",
        "directory": "packages/server"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "gen": "tern-codegen",
        "gen:watch": "tern-codegen --watch"
    },
    "dependencies": {
        "@jasonscharf/app": "workspace:^",
        "@jasonscharf/core": "workspace:^",
        "@jasonscharf/data": "workspace:^",
        "@jasonscharf/entities": "workspace:^",
        "@jasonscharf/gen": "workspace:^",
        "knex": "^3.1.0",
        "pino": "^8.17.2"
    },
    "tern": {
        "extension": "urn:sys:ext:rbac",
        "requires": [
            "urn:sys:core"
        ],
        "extensions": [
            "../core/ontology/rbac.ttl"
        ],
        "shapes": [
            "../core/ontology/rbac.shacl.ttl"
        ],
        "localNamespace": "urn:sys:core:rbac:",
        "idSegments": {
            "Install": "install",
            "UserGroup": "group",
            "ServiceAccount": "sa",
            "PolicyGrant": "grant",
            "ResourceNode": "resource"
        },
        "schemasOut": "./src/rbac/schemas.generated.ts"
    }
}
