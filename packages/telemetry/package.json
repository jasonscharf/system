{
    "name": "@jasonscharf/telemetry",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "source": "./src/index.ts",
            "default": "./dist/index.js",
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./instrumentation": {
            "source": "./src/instrumentation.ts",
            "default": "./dist/instrumentation.js",
            "import": "./dist/instrumentation.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jasonlscharf/system.git",
        "directory": "packages/telemetry"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm -f tsconfig.tsbuildinfo",
        "typecheck": "tsc -p tsconfig.json --noEmit"
    },
    "dependencies": {
        "@jasonscharf/core": "workspace:^",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.54.0",
        "@opentelemetry/exporter-prometheus": "^0.57.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
        "@opentelemetry/sdk-node": "^0.57.0",
        "pino": "^9.6.0"
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "pino-pretty": "^13.0.0"
    }
}
