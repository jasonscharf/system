        "@jasonscharf/core": "workspace:^",
        "@jasonscharf/data": "workspace:^",
        "@jasonscharf/entities": "workspace:^",
        "@jasonscharf/events": "workspace:^",
        "@jasonscharf/flow": "workspace:^",
        "@jasonscharf/gen": "workspace:^",
        "@jasonscharf/sandbox-labs": "workspace:^",
        "@jasonscharf/server": "workspace:^",
        "@jasonscharf/vaults": "workspace:^",
        "@jasonscharf/worker": "workspace:^",
        "react": "^19.2.3",
        "react-dom": "^19.2.3"
    },
    "devDependencies": {
        "@istanbuljs/nyc-config-typescript": "^1.0.2",
        "@playwright/test": "^1.57.0",
