{
  "name": "@system/test",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "yarn compile",
    "compile": "tsc -b",
    "clean": "rm -rf dist && rm tsconfig.tsbuildinfo",
    "start": "vitest run",
    "start:debug": "vitest watch --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "tsc -b -w"
  },
  "dependencies": {
    "@system/api": "workspace:^",
    "@system/app": "workspace:^",
    "@system/auth": "workspace:^",
    "@system/core": "workspace:^",
    "@system/data": "workspace:^",
    "@system/entities": "workspace:^",
    "@system/flow": "workspace:^",
    "@system/gen": "workspace:^",
    "@system/vaults": "workspace:^",
    "@system/worker": "workspace:^",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-istanbul": "4.0.16",
    "@vitest/coverage-v8": "^4.0.16",
    "jsdom": "^27.4.0",
    "nyc": "^17.1.0",
    "playwright-coverage": "^0.0.1-security",
    "vitest": "^4.0.16"
  }
}
