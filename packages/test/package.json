        "start:debug": "vitest watch --coverage --inspect=0.0.0.0:9231",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "watch": "tsc -b -w"
    },
    "dependencies": {
        "@jasonscharf/api": "workspace:^",
        "@jasonscharf/app": "workspace:^",
        "@jasonscharf/auth": "workspace:^",
