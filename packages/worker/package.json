{
    "name": "@jasonscharf/worker",
    "version": "0.1.0",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/jasonlscharf/system.git",
        "directory": "packages/worker"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com",
        "access": "public"
    },
    "scripts": {
        "build": "yarn compile",
        "compile": "tsc -b",
        "clean": "rm -rf dist && rm tsconfig.tsbuildinfo",
        "start": "node dist/index.js",
        "start:debug": "nodemon",
        "start:debug:break": "node --inspect-brk=0.0.0.0:9000 dist/index.js",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "watch": "tsc -b -w"
    },
    "dependencies": {
        "@jasonscharf/core": "workspace:^",
        "@jasonscharf/data": "workspace:^",
        "@jasonscharf/flow": "workspace:^",
        "cron-parser": "^5.5.0",
        "knex": "^3.1.0",
        "luxon": "^3.7.2",
        "nodemon": "^3.1.11"
    },
    "devDependencies": {
        "@types/luxon": "^3.7.1"
    }
}
